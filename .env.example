# --- Solana ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=
USDC_MINT=
TREASURY_WALLET=
# base64 of Solana keypair JSON array (devnet treasury payer)
SOLANA_TREASURY_KEYPAIR_B64=

# --- QuickNode ---
# Used to authenticate incoming webhook calls
QUICKNODE_WEBHOOK_TOKEN=

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Pricing ---
SOLANCO_SPREAD_BPS=200
SOLANCO_FLAT_FEE_KOBO=0
SOLANCO_QUOTE_TTL_SECONDS=120

# --- DB ---
# Use your own credentials; avoid committing real passwords.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/solanco?schema=public

# --- App ---
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
